# .env.example -- LangSmith 트레이싱용 환경변수 템플릿
#
# 사용 방법:
#   1. 이 파일을 워크스페이스 루트에 ".env" 이름으로 복사한다.
#      (예: copy examples\.env.example .env)
#   2. 아래 값을 실제 값으로 채운다.
#   3. .env 는 .gitignore 에 등록되어 있어 절대 git 에 커밋되지 않는다.
#
# 주의: 등호(=) 양옆에 공백을 두지 말고, 값에 따옴표도 붙이지 않는다.

LANGSMITH_API_KEY=여기에_발급받은_키_붙여넣기
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=cline-rag-examples
